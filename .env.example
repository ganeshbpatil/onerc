# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.oneracecourse.com        # [CONTENT REQUIRED] final domain
NEXT_PUBLIC_PHONE=+918855862268                           # [VERIFY] brochure says 8855864480
NEXT_PUBLIC_WHATSAPP_NUMBER=918855862268                  # digits only, with country code

# ─── Lead routing ─────────────────────────────────────────────────────
# Comma-separated adapter chain, tried in order; first success wins.
# Options: zoho_forms | zoho_crm | webhook | log
LEAD_ADAPTERS=zoho_forms,webhook,log

# Zoho Forms (primary). Use the form's "Embed → HTML" action URL:
# https://forms.zohopublic.in/<org>/form/<FormLinkName>/formperma/<PermaKey>/htmlRecords/submit
ZOHO_FORMS_SUBMIT_URL=
# Optional JSON overrides. Defaults match SKYi's existing Zoho web-to-lead form (see docs/07).
ZOHO_FORMS_FIELD_MAP=
ZOHO_FORMS_STATIC_FIELDS={"Project":"One Racecourse","SingleLine":"ONE RACECOURSE","SingleLine1":"Direct","SingleLine2":"DIGITAL","SingleLine3":"SKYi Websites","SingleLine8":"Digital"}

# Zoho CRM direct (optional fallback) — server-only OAuth self client
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CRM_API_URL=https://www.zohoapis.in/crm/v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_LEAD_SOURCE=Website - One Racecourse
CRM_PROJECT_ID=one-racecourse

# Generic webhook fallback (n8n / Make / Zapier). HMAC-SHA256 signed.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Gated brochure: private/One-Racecourse-Brochure.pdf (downloaded by `npm run assets`) is served via
# a signed 24h link after a valid lead. Set BROCHURE_URL only to use an external file instead.
BROCHURE_SIGNING_SECRET=change-me-to-a-long-random-string
BROCHURE_URL=

# ─── Analytics (public IDs only) ─────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side conversion APIs (secrets — never NEXT_PUBLIC)
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=

# ─── Abuse protection ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=5
