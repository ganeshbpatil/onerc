# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.oneracecourse.com        # [CONTENT REQUIRED] final domain
NEXT_PUBLIC_PHONE=+918855862268                           # [VERIFY] brochure says 8855864480
NEXT_PUBLIC_WHATSAPP_NUMBER=918855862268                  # digits only, with country code

# ─── Lead routing ─────────────────────────────────────────────────────
# Comma-separated adapter chain, tried in order; first success wins.
# Options: zoho_forms | zoho_crm | webhook | log
LEAD_ADAPTERS=zoho_forms,webhook,log

# Zoho Forms (primary). Use the form's "Embed → HTML" action URL:
# https://forms.zohopublic.in/<org>/form/<FormLinkName>/formperma/<PermaKey>/htmlRecords/submit
ZOHO_FORMS_SUBMIT_URL=
# JSON map: our field → Zoho field link name (see docs/07-analytics.md §Zoho field map)
ZOHO_FORMS_FIELD_MAP={"firstName":"Name_First","lastName":"Name_Last","mobile":"PhoneNumber_countrycode","email":"Email","configuration":"Dropdown","preferredTime":"Dropdown1","intent":"SingleLine","consent":"DecisionBox","utmSource":"SingleLine1","utmMedium":"SingleLine2","utmCampaign":"SingleLine3","utmContent":"SingleLine4","utmTerm":"SingleLine5","gclid":"SingleLine6","fbclid":"SingleLine7","landingPath":"SingleLine8","referrer":"SingleLine9","eventId":"SingleLine10"}

# Zoho CRM direct (optional fallback) — server-only OAuth self client
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CRM_API_URL=https://www.zohoapis.in/crm/v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_LEAD_SOURCE=Website - One Racecourse
CRM_PROJECT_ID=one-racecourse

# Generic webhook fallback (n8n / Make / Zapier). HMAC-SHA256 signed.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Gated brochure: returned only after a valid lead is accepted
BROCHURE_URL=https://cdn.example.com/one-racecourse/One-Racecourse-Brochure.pdf

# ─── Analytics (public IDs only) ─────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side conversion APIs (secrets — never NEXT_PUBLIC)
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=

# ─── Abuse protection ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=5
